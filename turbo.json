{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_CDN_URL",
    "VERCEL_AUTOMATION_API_BYPASS_SECRET",
    "FRONTEND_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "REDIS_URL",

    "SUPABASE_URL",
    "SUPABASE_API_KEY",

    "UPSTASH_SEARCH_REST_URL",
    "UPSTASH_SEARCH_REST_TOKEN",

    "NODE_ENV",
    "IS_SERVELESS",
    "PORT",
    "STRIPE_API_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "DB_URL",
    "DB_SYNCHRONIZE",
    "DB_LOGGING",
    "JWT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",

    "RESEND_API_KEY",

    "WHATSAPP_VERIFY_TOKEN"
  ],
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "with": ["@repo/api#dev"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_CDN_URL",
        "VERCEL_AUTOMATION_API_BYPASS_SECRET",
        "FRONTEND_URL",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "REDIS_URL",

        "SUPABASE_URL",
        "SUPABASE_API_KEY",

        "UPSTASH_SEARCH_REST_URL",
        "UPSTASH_SEARCH_REST_TOKEN",

        "NODE_ENV",
        "IS_SERVELESS",
        "PORT",
        "STRIPE_API_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "DB_URL",
        "DB_SYNCHRONIZE",
        "DB_LOGGING",
        "JWT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",

        "RESEND_API_KEY",
        "WHATSAPP_VERIFY_TOKEN"
      ]
    },
    "lint": {}
  }
}
