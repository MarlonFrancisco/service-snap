{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_CDN_URL",
    "NEXT_PUBLIC_GTM_ID",
    "NEXT_PUBLIC_ANALYTICS_DEBUG",
    "VERCEL_AUTOMATION_API_BYPASS_SECRET",
    "FRONTEND_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "REDIS_URL",

    "R2_BUCKET",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",

    "UPSTASH_SEARCH_REST_URL",
    "UPSTASH_SEARCH_REST_TOKEN",

    "NODE_ENV",
    "IS_SERVELESS",
    "PORT",
    "STRIPE_API_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "DB_URL",
    "DB_SYNCHRONIZE",
    "DB_LOGGING",
    "JWT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",

    "RESEND_API_KEY",

    "WHATSAPP_VERIFY_TOKEN",

    "DATA_ENCRYPTION_KEY",
    "PLATFORM_ADMIN_EMAILS",
    "API_PUBLIC_URL",
    "QSTASH_TOKEN",
    "QSTASH_URL",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT"
  ],
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "with": ["@repo/api#dev"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_CDN_URL",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_ANALYTICS_DEBUG",
        "VERCEL_AUTOMATION_API_BYPASS_SECRET",
        "FRONTEND_URL",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "REDIS_URL",

        "R2_BUCKET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",

        "UPSTASH_SEARCH_REST_URL",
        "UPSTASH_SEARCH_REST_TOKEN",

        "NODE_ENV",
        "IS_SERVELESS",
        "PORT",
        "STRIPE_API_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "DB_URL",
        "DB_SYNCHRONIZE",
        "DB_LOGGING",
        "JWT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",

        "RESEND_API_KEY",
        "WHATSAPP_VERIFY_TOKEN",
        "DATA_ENCRYPTION_KEY",
        "PLATFORM_ADMIN_EMAILS",
        "API_PUBLIC_URL",
        "QSTASH_TOKEN",
        "QSTASH_URL",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT"
      ]
    },
    "lint": {}
  }
}
