# =============================================================================
# apps/web — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha. Em Vercel: projeto service-span-web
# =============================================================================

# API (rewrite /api/* → NEXT_PUBLIC_API_URL/*; SSR usa a URL completa)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Identity Services (client-side)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# CDN de mídia (Supabase storage / CDN público)
NEXT_PUBLIC_CDN_URL=https://xxxx.supabase.co/storage/v1/object/public

# Google Tag Manager (opcional; sem ele nenhuma tag é carregada)
NEXT_PUBLIC_GTM_ID=

# Mostra no console os eventos de analytics (opcional)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# Bypass de Deployment Protection ao chamar a API em preview (opcional)
# VERCEL_AUTOMATION_API_BYPASS_SECRET=
