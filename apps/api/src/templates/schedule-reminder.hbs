<html lang='pt-BR'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Lembrete do seu agendamento</title>
  </head>
  <body style='margin: 0; padding: 0; background-color: #f4f4f4;'>
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      border='0'
      width='100%'
      style='background-color: #f4f4f4;'
    >
      <tr>
        <td align='center' style='padding: 40px 20px;'>
          <table
            role='presentation'
            cellpadding='0'
            cellspacing='0'
            border='0'
            width='600'
            style='max-width: 600px; background-color: #ffffff; border-radius: 8px; overflow: hidden;'
          >
            <tr>
              <td
                align='center'
                style='background-color: #1e293b; padding: 40px 20px;'
              >
                <h1
                  style='margin: 0; font-family: Arial, sans-serif; font-size: 28px; font-weight: bold; color: #ffffff;'
                >Seu atendimento está chegando!</h1>
                <p
                  style='margin: 10px 0 0 0; font-family: Arial, sans-serif; font-size: 16px; color: #5eead4;'
                >{{storeName}}</p>
              </td>
            </tr>
            <tr>
              <td style='padding: 40px; font-family: Arial, sans-serif;'>
                <p style='margin: 0 0 24px 0; font-size: 18px; color: #374151;'>
                  Olá
                  <strong style='color: #1e293b;'>{{customerName}}</strong>,
                  este é um lembrete do seu agendamento.
                </p>
                {{#if customMessage}}
                  <p style='margin: 0 0 24px 0; font-size: 16px; color: #374151;'>
                    {{customMessage}}
                  </p>
                {{/if}}
                <table
                  role='presentation'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  width='100%'
                  style='border: 1px solid #e5e7eb; border-radius: 8px;'
                >
                  <tr>
                    <td style='padding: 24px; font-size: 16px; color: #1e293b;'>
                      <p style='margin: 0 0 12px 0;'><strong>Data e hora:</strong>
                        {{scheduleDate}}</p>
                      <p style='margin: 0 0 12px 0;'><strong>Serviço:</strong>
                        {{serviceName}}</p>
                      <p style='margin: 0;'><strong>Profissional:</strong>
                        {{professionalName}}</p>
                      {{#if storeAddress}}
                        <p style='margin: 12px 0 0 0;'><strong>Endereço:</strong>
                          {{storeAddress}}</p>
                      {{/if}}
                      {{#if storePhone}}
                        <p style='margin: 12px 0 0 0;'><strong>Telefone:</strong>
                          {{storePhone}}</p>
                      {{/if}}
                    </td>
                  </tr>
                </table>
                <p style='margin: 30px 0 0 0; text-align: center;'>
                  <a
                    href='{{rescheduleLink}}'
                    target='_blank'
                    style='display: inline-block; padding: 14px 24px; background-color: #ffffff; color: #374151; font-size: 14px; font-weight: bold; text-decoration: none; border-radius: 6px; border: 1px solid #d1d5db;'
                  >Cancelar ou Reagendar</a>
                </p>
              </td>
            </tr>
            <tr>
              <td
                style='border-top: 1px solid #e5e7eb; padding: 30px 40px; text-align: center;'
              >
                <p
                  style='margin: 0; font-family: Arial, sans-serif; font-size: 12px; color: #9ca3af;'
                >
                  &copy;
                  {{currentYear}}
                  ServiceSnap - Agendamentos Inteligentes
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
