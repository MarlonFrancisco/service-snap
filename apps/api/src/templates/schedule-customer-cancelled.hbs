<span style='display: inline-block; margin-bottom: 12px; padding: 4px 11px; border-radius: 999px; background-color: #fbe8e6; color: #a4231a; font-size: 12px; font-weight: bold;'>Cancelado pelo cliente</span>
<h1 style='margin: 0; font-size: 28px; line-height: 32px; font-weight: bold; color: #0b0b0f;'>{{customerName}} cancelou o horário</h1>
<p style='margin: 12px 0 0 0; font-size: 15px; line-height: 23px; color: #2c2a36;'>Esse horário está livre de novo na agenda.</p>
<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin-top: 20px; background-color: #f7f6fa; border-radius: 14px; font-size: 14px;'>
  <tr><td style='padding: 18px 20px 5px 20px; color: #5f5c6e;'>Data e horário</td><td align='right' style='padding: 18px 20px 5px 20px; font-weight: bold;'>{{scheduleDay}} às {{scheduleTime}}</td></tr>
  <tr><td style='padding: 5px 20px; color: #5f5c6e;'>Serviço</td><td align='right' style='padding: 5px 20px; font-weight: bold;'>{{serviceName}}</td></tr>
  <tr><td style='padding: 5px 20px; color: #5f5c6e;'>Profissional</td><td align='right' style='padding: 5px 20px; font-weight: bold;'>{{professionalName}}</td></tr>
  {{#if customerPhone}}
    <tr><td style='padding: 5px 20px; color: #5f5c6e;'>Cliente</td><td align='right' style='padding: 5px 20px; font-weight: bold;'>{{customerPhone}}</td></tr>
  {{/if}}
  <tr><td style='padding: 5px 20px 18px 20px; color: #5f5c6e;'>Loja</td><td align='right' style='padding: 5px 20px 18px 20px; font-weight: bold;'>{{storeName}}</td></tr>
</table>
<p style='margin: 24px 0 0 0;'>
  <a href='{{agendaLink}}' target='_blank' class='btn' style='display: inline-block; margin: 0 10px 10px 0; padding: 15px 24px; border-radius: 999px; background-color: #0b0b0f; color: #ffffff; font-size: 14px; font-weight: bold; text-decoration: none;'>Ver na agenda</a>
</p>
