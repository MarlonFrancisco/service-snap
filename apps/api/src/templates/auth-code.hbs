<h1 style='margin: 0; font-size: 28px; line-height: 32px; font-weight: bold; color: #0b0b0f;'>{{title}}</h1>
<p style='margin: 12px 0 0 0; font-size: 15px; line-height: 23px; color: #2c2a36;'>{{intro}}</p>
<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin-top: 24px; background-color: #f7f6fa; border-radius: 14px;'>
  <tr>
    <td align='center' style='padding: 22px; font-size: 36px; line-height: 40px; font-weight: bold; letter-spacing: 5px; color: #0b0b0f;'>{{code}}</td>
  </tr>
</table>
<p style='margin: 24px 0 0 0; font-size: 15px; line-height: 23px; color: #2c2a36;'>{{ignoreNote}}</p>
