<span style='display: inline-block; margin-bottom: 12px; padding: 4px 11px; border-radius: 999px; background-color: #f3e8ff; color: #6e0ab8; font-size: 12px; font-weight: bold;'>Faz tempo que você não vem</span>
<h1 style='margin: 0; font-size: 28px; line-height: 32px; font-weight: bold; color: #0b0b0f;'>Olá, {{customerName}}</h1>
<p style='margin: 12px 0 0 0; font-size: 15px; line-height: 23px; color: #2c2a36;'>{{#each messageLines}}{{this}}{{#unless @last}}<br />{{/unless}}{{/each}}</p>
<p style='margin: 24px 0 0 0;'>
  <a href='{{bookingLink}}' target='_blank' class='btn' style='display: inline-block; margin: 0 10px 10px 0; padding: 15px 24px; border-radius: 999px; background-color: #0b0b0f; color: #ffffff; font-size: 14px; font-weight: bold; text-decoration: none;'>Marcar um horário</a>
</p>
{{#if lastVisit}}
  <p style='margin: 12px 0 0 0; font-size: 15px; line-height: 23px; color: #2c2a36;'>Sua última visita foi em {{lastVisit}}.</p>
{{/if}}
