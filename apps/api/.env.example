# =============================================================================
# apps/api — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha. Em Vercel: projeto service-span-api
# =============================================================================

# Runtime
NODE_ENV=development
PORT=3000
# true = handler serverless (Vercel); omita/false em `pnpm dev` local
IS_SERVELESS=false

# CORS / links (URL do frontend)
FRONTEND_URL=http://localhost:3001

# Database (TypeORM) — use connection string, não DB_HOST/DB_* legados
DB_URL=postgresql://user:password@host:5432/service_snap?sslmode=require
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Auth
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage (Supabase) — substituiu AWS S3
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_API_KEY=

# Cache (ioredis via URL). Sem REDIS_URL → cache em memória
REDIS_URL=redis://default:password@host:6379

# Search (Upstash Search — não confundir com Upstash Redis)
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=

# Email
SENDGRID_API_KEY=

# WhatsApp webhook
WHATSAPP_VERIFY_TOKEN=
