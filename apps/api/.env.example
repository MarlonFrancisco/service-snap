# =============================================================================
# apps/api — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha. Em Vercel: projeto service-span-api
# =============================================================================

# Runtime
NODE_ENV=development
PORT=3000
# true = handler serverless (Vercel); omita/false em `pnpm dev` local
IS_SERVELESS=false

# CORS / links (URL do frontend)
FRONTEND_URL=http://localhost:3001

# Database (TypeORM) — use connection string, não DB_HOST/DB_* legados
DB_URL=postgresql://user:password@host:5432/service_snap?sslmode=require
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Auth
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage (Cloudflare R2 — S3-compatible)
# Bucket do ambiente: ssnap-production ou ssnap-development
R2_BUCKET=ssnap-development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cache (Redis via URL). Sem REDIS_URL → cache em memória
REDIS_URL=redis://default:password@host:6379

# Search (Upstash Search — não confundir com Upstash Redis)
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=

# Email (Resend) — domínio ssnap.io deve estar verificado no dashboard
RESEND_API_KEY=re_...

# WhatsApp webhook
WHATSAPP_VERIFY_TOKEN=

# Agendador de lembretes: enviado como "Authorization: Bearer <valor>"
CRON_SECRET=

# Chave de 32 bytes em base64 (openssl rand -base64 32) para dados cifrados:
# segredos de webhook e respostas de anamnese. Trocar a chave torna ilegível
# o que já foi gravado.
DATA_ENCRYPTION_KEY=

# E-mails (separados por vírgula) com acesso ao painel da plataforma (/admin)
PLATFORM_ADMIN_EMAILS=

# Fila (Upstash QStash): avisos de agendamento, webhooks e campanhas. API_PUBLIC_URL
# é o endereço público desta API: o QStash chama ${API_PUBLIC_URL}/queue/jobs.
# Sem token, os avisos rodam dentro da requisição e as campanhas ficam desligadas.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
API_PUBLIC_URL=

# Notificações push (Web Push / VAPID). Sem as três, o push fica desligado e
# os avisos por e-mail seguem normais.
# - Gere o par uma vez com: npx web-push generate-vapid-keys
# - Só a API usa: o web busca a chave pública em GET /push/public-key
# - Não troque o par depois de publicado: as inscrições ficam presas à chave
#   pública, e trocar obriga cada usuário a ativar os avisos de novo
# - Na Vercel, cadastre VAPID_PRIVATE_KEY como "Sensitive"
# - VAPID_SUBJECT é o contato (mailto: ou https:) que o serviço de push usa
#   para avisar sobre problemas
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@ssnap.io
